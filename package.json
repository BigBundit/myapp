    "build": "tsc",
    "start:dist": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "^17.2.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
