{
  "name": "wordpress-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only WordPress + WooCommerce MCP server for ChatGPT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
